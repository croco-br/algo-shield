# =============================================================================
# Multi-stage Dockerfile for AlgoShield UI (Vue.js)
# Optimized: alpine + nginx package (~5MB) instead of nginx:alpine (~50MB)
# =============================================================================
# Stage 1: Dependencies stage
# =============================================================================
FROM node:20-alpine AS deps

# Install build dependencies
RUN apk add --no-cache libc6-compat

# Set working directory
WORKDIR /app

# Copy package files
COPY src/ui/package.json src/ui/package-lock.json ./

# Install dependencies with BuildKit cache mount
# Use npm ci for faster, reliable, reproducible builds
# Cache mount dramatically speeds up npm installs
RUN --mount=type=cache,target=/root/.npm \
    npm ci

# =============================================================================
# Stage 2: Builder stage
# =============================================================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy source code
COPY src/ui/ ./

# Accept build argument for API URL
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

# Set build-time environment variables
ENV NODE_ENV=production

# Build Vue.js application with BuildKit cache mount
# Cache mount speeds up Vite builds significantly
RUN --mount=type=cache,target=/app/node_modules/.vite \
    npm run build

# =============================================================================
# Stage 3: Runner stage (plain alpine + nginx package — minimal footprint)
# =============================================================================
FROM alpine:3.20 AS runner

# Install only the core nginx package from Alpine repos (~5MB vs ~50MB official image)
# Also install wget (via busybox, already present) for healthcheck
RUN apk add --no-cache nginx && \
    rm -rf /etc/nginx/http.d/default.conf /var/www/localhost

# Create non-root user and required directories
# Note: /var/lib/nginx, /var/log/nginx, /run/nginx are tmpfs mounts (see docker-compose.yml)
# Logs are sent to /dev/stdout and /dev/stderr (see nginx.conf)
RUN addgroup -S appgroup && \
    adduser -S appuser -G appgroup && \
    mkdir -p /usr/share/nginx/html && \
    chown -R appuser:appgroup /usr/share/nginx/html

# Copy custom nginx config
COPY nginx.conf /etc/nginx/nginx.conf

# Copy built static files from builder
COPY --from=builder --chown=appuser:appgroup /app/dist /usr/share/nginx/html

# Switch to non-root user
USER appuser:appgroup

# Expose port
EXPOSE 3000

# Health check using wget (provided by busybox in alpine)
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1

# Start nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
