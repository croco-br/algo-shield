#!/bin/bash

# AlgoShield Pre-Push Hook
# Runs full test suite before pushing to remote
# This ensures code quality without blocking frequent local commits

set -e

echo "🧪 Running pre-push tests..."

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if Go is installed
if ! command -v go &> /dev/null; then
    echo -e "${RED}✗ Go is not installed${NC}"
    exit 1
fi

# Check if we're in the right directory
if [ ! -f "go.mod" ]; then
    echo -e "${RED}✗ Not in project root directory${NC}"
    exit 1
fi

# Install gotestsum if not present
if ! command -v gotestsum &> /dev/null; then
    echo -e "${YELLOW}→ gotestsum not found. Installing...${NC}"
    go install gotest.tools/gotestsum@latest
fi

# Run Go tests with gotestsum for better formatting
echo -e "${YELLOW}→ Running Go unit tests...${NC}"
if gotestsum --format testdox -- -short -race -parallel 8 ./...; then
    echo -e "${GREEN}✓ Go tests passed${NC}"
else
    echo -e "${RED}✗ Go tests failed${NC}"
    echo -e "${YELLOW}Push aborted. Fix the tests and try again.${NC}"
    exit 1
fi

echo -e "${GREEN}✓ All pre-push checks passed! Pushing to remote...${NC}"
exit 0
