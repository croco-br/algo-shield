#!/bin/bash

# AlgoShield Pre-Commit Hook (Fast version)
# Runs only formatting and linting (30s)
# Tests moved to pre-push hook for better developer experience

set -e

echo "🔍 Running pre-commit checks..."

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if Go is installed
if ! command -v go &> /dev/null; then
    echo -e "${RED}✗ Go is not installed${NC}"
    exit 1
fi

# Check if we're in the right directory
if [ ! -f "go.mod" ]; then
    echo -e "${RED}✗ Not in project root directory${NC}"
    exit 1
fi

# Format Go code first
echo -e "${YELLOW}→ Formatting Go code...${NC}"
go fmt ./...
# Check if any Go files were reformatted
FORMATTED_FILES=$(git diff --name-only --diff-filter=ACM | grep '\.go$' || true)
if [ -n "$FORMATTED_FILES" ]; then
    echo -e "${YELLOW}⚠ Some Go files were reformatted${NC}"
    echo -e "${YELLOW}Reformatted files have been staged automatically${NC}"
    echo "$FORMATTED_FILES" | xargs git add
fi
echo -e "${GREEN}✓ Go code formatted${NC}"

# Run linters
echo -e "${YELLOW}→ Running linters...${NC}"
if make lint; then
    echo -e "${GREEN}✓ Lint checks passed${NC}"
else
    echo -e "${RED}✗ Lint checks failed${NC}"
    echo -e "${YELLOW}Commit aborted. Fix the lint errors and try again.${NC}"
    exit 1
fi

# Check for go.mod/go.sum consistency
echo -e "${YELLOW}→ Checking Go modules...${NC}"
go mod tidy -v
if [ -n "$(git diff go.mod go.sum)" ]; then
    echo -e "${YELLOW}⚠ go.mod or go.sum were modified by 'go mod tidy'${NC}"
    echo -e "${YELLOW}Changes have been staged automatically${NC}"
    git add go.mod go.sum
fi

echo -e "${GREEN}✓ All pre-commit checks passed!${NC}"
echo -e "${YELLOW}ℹ Tests will run on pre-push (see .githooks/pre-push)${NC}"
exit 0

