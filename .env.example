# AlgoShield Environment Variables
# Copy this file to .env and fill in the values

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=algoshield
POSTGRES_PASSWORD=your-database-password-here
POSTGRES_DB=algoshield

# Redis Configuration (Unified - DB0 for cache, DB1 for Asynq queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080

# SECURITY: Request Body Size Limit (in bytes)
# Default: 4MB (4194304 bytes) - prevents DoS attacks via large payloads
# Adjust based on your needs (e.g., 10MB = 10485760)
API_BODY_LIMIT=4194304

# TLS/HTTPS Configuration (REQUIRED in production for security)
TLS_ENABLE=false
TLS_CERT_PATH=
TLS_KEY_PATH=

# SECURITY: CORS Configuration
# IMPORTANT: In production, NEVER use "*" - specify allowed origins
# Development: Use "*" for local development
# Production: Use comma-separated list of allowed origins
# Example production value: CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=*

# SECURITY: CSRF Protection
# CSRF tokens are automatically generated on login/register and stored in Redis
# Frontend must include X-CSRF-Token header in all state-changing requests (POST/PUT/PATCH/DELETE)
# Token TTL: 24 hours (automatically expires)

# JWT Authentication Configuration
# SECURITY: Use strong random secret (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-here-minimum-32-characters
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_HOURS=168

# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=info

# API Timeouts (all durations in Go format: e.g., "500ms", "2s", "5m")
API_TIMEOUT_HANDLER=500ms
API_TIMEOUT_HEALTH=2s

# API Cache TTL (all durations in Go format)
API_CACHE_DASHBOARD_TTL=30s
API_CACHE_BRANDING_TTL=10m
API_CACHE_SYSTEM_TTL=5m
API_CACHE_RULES_TTL=5m

# Worker Configuration
WORKER_CONCURRENCY=10
WORKER_BATCH_SIZE=50
WORKER_TIMEOUT_TRANSACTION_PROCESSING=300ms
WORKER_TIMEOUT_RULE_EVALUATION=300ms
WORKER_RETRY_MAX_ATTEMPTS=3
WORKER_RETRY_INITIAL_DELAY=100ms
WORKER_RETRY_MAX_DELAY=5s
WORKER_RETRY_MULTIPLIER=2.0
WORKER_QUEUE_POP_TIMEOUT=1s
WORKER_RULES_RELOAD_INTERVAL=10s

# Worker Asynq Configuration (all durations in Go format)
WORKER_ASYNQ_DEFAULT_TIMEOUT=5m
WORKER_ASYNQ_DEFAULT_RETENTION=24h
WORKER_ASYNQ_CRITICAL_TIMEOUT=30s
WORKER_ASYNQ_LOW_PRIORITY_TIMEOUT=10m
WORKER_ASYNQ_SHUTDOWN_TIMEOUT=30s

# Redis Queue Configuration (Asynq uses DB1 on the same Redis instance)
REDIS_QUEUE_HOST=localhost
REDIS_QUEUE_PORT=6379
REDIS_QUEUE_DB=1

# Asynq Worker Configuration
ASYNQ_CONCURRENCY=10
ASYNQ_QUEUE_CRITICAL_WEIGHT=6
ASYNQ_QUEUE_DEFAULT_WEIGHT=3
ASYNQ_QUEUE_LOW_WEIGHT=1

# UI Configuration (build-time variables, must be set during build)
VITE_API_URL=http://localhost:8080
VITE_API_TIMEOUT=30000
VITE_API_RETRY_MAX_ATTEMPTS=3
VITE_API_RETRY_INITIAL_DELAY=1000
VITE_API_RETRY_MAX_DELAY=10000
VITE_API_RETRY_MULTIPLIER=2.0
VITE_UI_TOAST_DURATION=5000
VITE_UI_POLLING_INTERVAL=10000
VITE_SERVICE_NAME=AlgoShield
