# =============================================================================
# Multi-stage Dockerfile for AlgoShield API
# Optimized: scratch runtime (~70% total size reduction)
# =============================================================================
# Stage 1: Build stage
# =============================================================================
FROM --platform=$BUILDPLATFORM golang:1.25.5-alpine AS builder

# Target platform args (injected by Docker BuildKit)
ARG TARGETOS=linux
ARG TARGETARCH

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

# Create appuser for security (non-root user)
RUN adduser -D -g '' -u 10001 appuser

# Set working directory
WORKDIR /build

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies with BuildKit cache mount
# Cache persists between builds, dramatically speeding up dependency downloads
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download

# Copy only necessary source code to preserve cache
# Copy shared packages first (most stable)
COPY src/pkg/ ./src/pkg/
# Copy API-specific code
COPY src/api/ ./src/api/

# Build the API binary with BuildKit cache mount
# CGO_ENABLED=0 creates a statically linked binary
# -ldflags="-w -s" reduces binary size by removing debug info
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    GOCACHE=/root/.cache/go-build \
    GOMODCACHE=/go/pkg/mod \
    go build \
    -ldflags='-w -s -extldflags "-static"' \
    -trimpath \
    -o /build/bin/api \
    ./src/api/cmd/main.go

# Build a tiny static healthcheck binary for scratch image
# Uses raw TCP dial (not net/http) to keep the binary minimal
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    GOCACHE=/root/.cache/go-build \
    GOMODCACHE=/go/pkg/mod \
    go build \
    -ldflags='-w -s' \
    -trimpath \
    -o /build/bin/healthcheck \
    ./src/pkg/healthcheck/main.go

# =============================================================================
# Stage 2: Runtime stage (scratch — 0 bytes base image)
# =============================================================================
FROM scratch

# Import CA certificates for HTTPS outbound connections
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Import timezone data for time.LoadLocation support
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo

# Import passwd/group for non-root user
COPY --from=builder /etc/passwd /etc/passwd
COPY --from=builder /etc/group /etc/group

# Copy binaries from builder
COPY --from=builder --chown=10001:10001 /build/bin/api /api
COPY --from=builder --chown=10001:10001 /build/bin/healthcheck /healthcheck

# Switch to non-root user
USER appuser:appuser

# Expose port
EXPOSE 8080

# Health check using the custom static healthcheck binary
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["/healthcheck"]

# Run the binary
ENTRYPOINT ["/api"]
